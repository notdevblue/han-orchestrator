{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [{ "type": "command", "command": "python \"${PLUGIN_ROOT}/codex/session_rules.py\"", "timeout": 10 }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "python \"${PLUGIN_ROOT}/codex/session_rules.py\"", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|apply_patch|ApplyPatch",
        "hooks": [{ "type": "command", "command": "python \"${PLUGIN_ROOT}/codex/mission_guard.py\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|apply_patch|ApplyPatch",
        "hooks": [{ "type": "command", "command": "python \"${PLUGIN_ROOT}/codex/question_integrity.py\"", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${PLUGIN_ROOT}/codex/question_integrity.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
